+// 通用防抖：连续触发时只在停止 wait 毫秒后执行最后一次（用于 @ 搜索等高频输入）
+function debounce(fn, wait) {
+    let timer = null;
+    return function (...args) {
+        if (timer) clearTimeout(timer);
+        timer = setTimeout(() => {
+            timer = null;
+            fn.apply(this, args);
+        }, wait);
+    };
+}
