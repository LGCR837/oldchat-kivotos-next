# Generated by Cargo
# will have compiled files and executables
/target/

# Generated by Tauri
# will have schema files for capabilities auto-completion
/gen/schemas

# Android / iOS 工程由 `tauri android init` / `tauri ios init` 生成，不入库
/gen/android
/gen/ios

# 发布签名密钥（本地生成，等同私钥，绝不可入库）
/android-release-key.jks
