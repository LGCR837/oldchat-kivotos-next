{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "opener:default",
    "notification:default",
    "dialog:default",
    {
      "identifier": "http:default",
      "allow": [
        { "url": "http://oc.mcl0.dpdns.org/**" },
        { "url": "https://old.chat/**" },
        { "url": "http://old.chat/**" },
        { "url": "https://**" }
      ]
    }
  ]
}
